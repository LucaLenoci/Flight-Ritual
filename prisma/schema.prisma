// Persistence layer schema. Mirrors the domain model in src/domain but stays
// a plain data shape — mapping to/from rich domain entities happens in
// src/infrastructure/persistence repositories, never in application code.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             String              @id @default(cuid())
  createdAt      DateTime            @default(now())
  flightMemories FlightMemory[]
  airportCards   UserAirportCard[]
  aircraftCards  UserAircraftCard[]
  airlineCards   UserAirlineCard[]
}

model Airport {
  iataCode  String   @id
  icaoCode  String   @unique
  name      String
  city      String
  country   String
  latitude  Float
  longitude Float
  timeZone  String

  originFlights      Flight[]          @relation("OriginAirport")
  destinationFlights Flight[]          @relation("DestinationAirport")
  userCards          UserAirportCard[]
}

model Airline {
  iataCode String   @id
  icaoCode String   @unique
  name     String
  flights  Flight[]
  userCards UserAirlineCard[]
}

model AircraftType {
  icaoTypeCode String     @id
  manufacturer String
  model        String
  facts        String // JSON-encoded string[] of interesting facts
  aircraft     Aircraft[]
  userCards    UserAircraftCard[]
}

model Aircraft {
  registration     String       @id
  aircraftTypeCode String
  aircraftType     AircraftType @relation(fields: [aircraftTypeCode], references: [icaoTypeCode])
  operatorIataCode String?
  manufactureDate  DateTime?

  assignments AircraftAssignment[]
}

model Flight {
  id                     String    @id @default(cuid())
  flightNumber           String
  airlineIataCode        String
  airline                Airline   @relation(fields: [airlineIataCode], references: [iataCode])
  originIataCode         String
  origin                 Airport   @relation("OriginAirport", fields: [originIataCode], references: [iataCode])
  destinationIataCode    String
  destination            Airport   @relation("DestinationAirport", fields: [destinationIataCode], references: [iataCode])
  scheduledDepartureUtc  DateTime
  scheduledArrivalUtc    DateTime
  actualDepartureUtc     DateTime?
  actualArrivalUtc       DateTime?
  gate                   String?
  delayMinutes           Int       @default(0)
  phase                  String    @default("SCHEDULED")

  aircraftAssignment AircraftAssignment?
  journeyEvents      JourneyEvent[]
  flightMemories     FlightMemory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([flightNumber, scheduledDepartureUtc])
  @@index([phase])
}

model AircraftAssignment {
  id                 String   @id @default(cuid())
  flightId           String   @unique
  flight             Flight   @relation(fields: [flightId], references: [id])
  aircraftRegistration String
  aircraft           Aircraft @relation(fields: [aircraftRegistration], references: [registration])
  source             String
  confidence         String
  assignedAtUtc      DateTime @default(now())
}

// One row per distinct journey occurrence. `sequenceKey` disambiguates
// repeatable event types (e.g. GATE_CHANGED can fire more than once per
// flight); the unique constraint is what makes ingestion idempotent —
// re-processing the same provider payload never creates a duplicate row.
model JourneyEvent {
  id          String   @id @default(cuid())
  flightId    String
  flight      Flight   @relation(fields: [flightId], references: [id])
  type        String
  sequenceKey String
  occurredAtUtc DateTime
  payload     String // JSON-encoded event-specific detail

  @@unique([flightId, type, sequenceKey])
  @@index([flightId])
}

// A user's saved memory of a flight. `flightId` is intentionally NOT globally
// unique: the same real-world flight can be saved by many different users,
// each to their own legacy log. Uniqueness is scoped per (userId, flightId)
// so a single user can't save the same flight twice.
model FlightMemory {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  flightId     String
  flight       Flight   @relation(fields: [flightId], references: [id])
  snapshotJson String // JSON-encoded FlightMemorySnapshot, captured at save time
  savedAtUtc   DateTime @default(now())
  note         String?

  @@unique([userId, flightId])
  @@index([userId])
}

// Collectible Cards ownership. Each of these three junction tables is the
// database-level source of truth for "does this user already own this
// card" — the @@unique constraint is what guarantees no duplicate can ever
// be created, even under concurrent unlock attempts for the same user and
// entity (a safe create-and-catch-conflict upsert relies on this, not on
// an application-level check, which could race). The reference entities
// (Airport/AircraftType/Airline) are shared, not duplicated per user; only
// firstCollectedAtUtc is per-user state here.
model UserAirportCard {
  id                  String   @id @default(cuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id])
  airportIataCode     String
  airport             Airport  @relation(fields: [airportIataCode], references: [iataCode])
  firstCollectedAtUtc DateTime @default(now())

  @@unique([userId, airportIataCode])
  @@index([userId])
}

model UserAircraftCard {
  id                  String       @id @default(cuid())
  userId              String
  user                User         @relation(fields: [userId], references: [id])
  aircraftTypeCode    String
  aircraftType        AircraftType @relation(fields: [aircraftTypeCode], references: [icaoTypeCode])
  firstCollectedAtUtc DateTime     @default(now())

  @@unique([userId, aircraftTypeCode])
  @@index([userId])
}

model UserAirlineCard {
  id                  String   @id @default(cuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id])
  airlineIataCode     String
  airline             Airline  @relation(fields: [airlineIataCode], references: [iataCode])
  firstCollectedAtUtc DateTime @default(now())

  @@unique([userId, airlineIataCode])
  @@index([userId])
}
